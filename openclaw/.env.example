# ─────────────────────────────────────────────────────────────────────────────
# OpenClaw configuration. Copy this file to ".env" and edit the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Which messaging channels to run. Comma-separated. Options:
#   whatsapp   - WhatsApp via QR (free, works out of the box)
#   webhook    - generic HTTP endpoint (SMS forwarders, Phone Link, Tasker, custom)
#   googlechat - Google Chat app endpoint (needs Google Workspace)
#   wechat     - WeChat via Wechaty (needs a puppet; see docs)
OPENCLAW_CHANNELS=whatsapp

# REQUIRED: who is allowed to command your agents.
# Phone/WhatsApp numbers — full international format, digits only (no +/spaces).
# Example: 14155550123,447700900123
OPENCLAW_ALLOWED_NUMBERS=
# Other channels identify users differently (Google Chat = email, WeChat = id,
# webhook = whatever you send). List those allowed ids here, comma-separated.
# Example: me@gmail.com,wxid_abc123
OPENCLAW_ALLOWED_USERS=

# If you REALLY want to let anyone who messages the linked number drive your
# agents, set this to "true". Dangerous — leave it false unless you know why.
OPENCLAW_ALLOW_ALL=false

# How OpenClaw runs your agents. Switchable backends:
#   cli       - Claude Code CLI (default). Uses your existing Claude subscription.
#   ollama    - a local Ollama model = truly free agents (see Ollama section).
#   openclaw  - the external OpenClaw runtime/CLI (see OpenClaw section below).
OPENCLAW_BACKEND=cli

# Path to the Claude Code executable. Leave as "claude" if it is on your PATH.
OPENCLAW_CLAUDE_BIN=claude

# ─── Ollama backend (only used when OPENCLAW_BACKEND=ollama) ─────────────────
# Runs a local model as your free agents. OpenClaw invokes `ollama run <model>`
# and pipes the message on stdin. To use it:
#   OPENCLAW_BACKEND=ollama
# The model you launch with `ollama run openclaw` (defaults to "openclaw"):
OPENCLAW_OLLAMA_MODEL=openclaw
OPENCLAW_OLLAMA_BIN=ollama
# Optional: warm up Ollama / your runtime when the gateway opens. Runs in the
# background. If your launch command is interactive/long-running, that's fine.
#   OPENCLAW_LAUNCH_CMD=ollama serve
OPENCLAW_LAUNCH_CMD=

# ─── OpenClaw-runtime backend (only used when OPENCLAW_BACKEND=openclaw) ──────
# OpenClaw's command surface varies by version, so this adapter is configurable.
# Easiest: set a full command template with placeholders {agent} {session}
# {prompt} (the message is also piped on stdin). Example:
#   OPENCLAW_CLI_CMD=openclaw run --agent {agent} --session {session}
OPENCLAW_CLI_CMD=
# If you don't set a template, OpenClaw is invoked as:
#   <bin> <subcommand> [--agent <slug>] [--session <id>]   (message on stdin)
OPENCLAW_CLI_BIN=openclaw
OPENCLAW_CLI_SUBCOMMAND=run
# Prepend the chosen Agency agent's personality to the message, so it's honoured
# even if that agent isn't registered inside your OpenClaw runtime.
OPENCLAW_INLINE_PERSONA=true

# Working directory the agents operate in (where they read/write files).
# Defaults to your home directory. Point this at a project to get work done there.
OPENCLAW_WORKDIR=

# Permission mode for the headless agent runs:
#   default       - asks for permission (won't work well headless; safest)
#   acceptEdits   - auto-accepts file edits, still gated on risky actions (good default)
#   bypass        - fully autonomous: runs commands without asking. Maximum
#                   "get the job done remotely" power, maximum risk. Only enable
#                   if OPENCLAW_WORKDIR is a sandbox/project you trust it in.
OPENCLAW_PERMISSION_MODE=acceptEdits

# Max seconds a single agent run may take before OpenClaw gives up.
OPENCLAW_TIMEOUT_SECONDS=600

# Default agent to route messages to when you haven't picked one with /use.
# Use an agent slug (see /agents), or leave blank for the general assistant.
OPENCLAW_DEFAULT_AGENT=

# ─── Media: images & voice notes ─────────────────────────────────────────────

# Accept image and voice-note messages from WhatsApp. Images are saved locally
# and read by the agent; voice notes are transcribed to text. Set false to
# accept text only.
OPENCLAW_ENABLE_MEDIA=true

# Where downloaded attachments are stored. Defaults to <workdir>/.openclaw-media.
OPENCLAW_MEDIA_DIR=

# Voice-note transcription. Easiest option: install openai-whisper
# (`pip install -U openai-whisper`) and OpenClaw will use it automatically.
# To use a different engine, set a command template here; {file} is replaced
# with the audio path and the command must print the transcript to stdout.
# Examples:
#   OPENCLAW_TRANSCRIBE_CMD=whisper-cpp -f {file} -nt
#   OPENCLAW_TRANSCRIBE_CMD=curl -s -F file=@{file} http://localhost:9000/asr
OPENCLAW_TRANSCRIBE_CMD=

# Whisper model for the built-in fallback (tiny|base|small|medium|large).
# Bigger = more accurate but slower. "base" is a good balance.
OPENCLAW_WHISPER_MODEL=base

# ─── Channel: webhook (Phone Link / SMS forwarders / custom bridges) ──────────
# Anything that can POST JSON { "user": "...", "text": "..." } can drive your
# agents. Used when OPENCLAW_CHANNELS includes "webhook".
OPENCLAW_WEBHOOK_PORT=8765
OPENCLAW_WEBHOOK_PATH=/openclaw
# Shared secret required in the `x-openclaw-token` header (strongly recommended).
OPENCLAW_WEBHOOK_TOKEN=
# Optional: POST replies here instead of returning them in the HTTP response
# (for async senders like an SMS app). {text}/{user} are available in the JSON body.
OPENCLAW_WEBHOOK_REPLY_URL=

# ─── Channel: Google Chat (needs Google Workspace) ───────────────────────────
OPENCLAW_GCHAT_PORT=8766
OPENCLAW_GCHAT_PATH=/googlechat
OPENCLAW_GCHAT_TOKEN=

# ─── Channel: WeChat (needs Wechaty + a puppet) ──────────────────────────────
# Install: npm i wechaty wechaty-puppet-wechat   (web puppet is free but often
# blocked by Tencent; padlocal/service puppets are more reliable but need a token)
OPENCLAW_WECHAT_PUPPET=wechaty-puppet-wechat
OPENCLAW_WECHAT_TOKEN=
